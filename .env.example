POSTGRES_DB=loadforge
POSTGRES_USER=loadforge
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
LOADFORGE_TOKEN_SECRET=
LOADFORGE_MODEL_DIR=models/artifacts
# Preencha apenas para executar o backend fora do Docker Compose.
DATABASE_URL=
# Fora do Compose, habilite a posse exclusiva do motor e a recuperação no startup.
# Use um único processo/worker da API por banco. O Compose já força este valor.
LOADFORGE_MANAGED_RUNTIME=1
