erDiagram
    direction LR
    USER ||--o{ PROJECT : possui
    PROJECT ||--o{ ENDPOINT : contem
    PROJECT ||--o{ TEST_SCENARIO : organiza
    ENDPOINT ||--o{ TEST_SCENARIO : configura
    USER ||--o{ TEST_SCENARIO : cria
    TEST_SCENARIO ||--o{ TEST_EXECUTION : origina
    USER ||--o{ TEST_EXECUTION : inicia
    MODEL_VERSION o|--o{ TEST_EXECUTION : habilita
    TEST_EXECUTION ||--o{ METRIC_WINDOW : registra
    MODEL_VERSION ||--o{ RISK_PREDICTION : gera
    METRIC_WINDOW ||--o| RISK_PREDICTION : recebe
    METRIC_WINDOW ||--o| CONTROL_DECISION : produz
    RISK_PREDICTION o|--o| CONTROL_DECISION : subsidia
    TEST_EXECUTION ||--o| EXECUTION_REPORT : consolida

    USER {
      uuid id PK
      string email UK
      string role
    }
    PROJECT {
      uuid id PK
      uuid owner_id FK
      string name
    }
    ENDPOINT {
      uuid id PK
      uuid project_id FK
      string base_url
      boolean authorization_confirmed
    }
    TEST_SCENARIO {
      uuid id PK
      uuid project_id FK
      uuid endpoint_id FK
      string strategy
    }
    TEST_EXECUTION {
      uuid id PK
      uuid scenario_id FK
      uuid model_version_id FK
      string status
    }
    METRIC_WINDOW {
      uuid id PK
      uuid execution_id FK
      int sequence_number UK
      decimal throughput_rps
      decimal latency_p95_ms
      decimal error_rate
    }
    MODEL_VERSION {
      uuid id PK
      string version UK
      string algorithm
      string status
    }
    RISK_PREDICTION {
      uuid id PK
      uuid metric_window_id FK
      uuid model_version_id FK
      decimal risk_probability
    }
    CONTROL_DECISION {
      uuid id PK
      uuid metric_window_id FK
      uuid risk_prediction_id FK
      string action
      int next_concurrency
    }
    EXECUTION_REPORT {
      uuid id PK
      uuid execution_id FK
      int total_requests
      decimal final_error_rate
    }

    PROJECT ||--o{ COMPARISON_REPORT : organiza
    USER ||--o{ COMPARISON_REPORT : cria
    COMPARISON_REPORT ||--|{ COMPARISON_REPORT_EXECUTION : agrupa
    TEST_EXECUTION ||--o{ COMPARISON_REPORT_EXECUTION : participa
    USER o|--o{ OPERATION_LOG : ator
    COMPARISON_REPORT {
      uuid id PK
      uuid project_id FK
      uuid created_by FK
      string conditions_fingerprint
      string results_json
    }
    COMPARISON_REPORT_EXECUTION {
      uuid id PK
      uuid comparison_report_id FK
      uuid execution_id FK
      int repetition_number
    }
    OPERATION_LOG {
      uuid id PK
      uuid actor_id FK
      string action
      string entity_type
      uuid entity_id
      string summary
      datetime created_at
    }
